# Połączenie do PostgreSQL (w compose host to `db`)
DATABASE_URL="postgresql://bible:zmien_mnie@db:5432/parallel_bible?schema=public"
# Port serwera aplikacji
PORT=5000

# --- Logowanie (Better Auth) ---
# Sekret podpisujący sesje. Wygeneruj: openssl rand -base64 32
# W produkcji jego brak zatrzymuje start aplikacji.
BETTER_AUTH_SECRET=""
# Publiczny adres aplikacji — musi się zgadzać, inaczej odbicie z Google nie wróci.
# Lokalnie można pominąć (domyślnie http://localhost:$PORT).
BETTER_AUTH_URL="https://biblia.twoja-domena.pl"

# Logowanie Google — opcjonalne. Bez tych dwóch zmiennych zostaje samo
# logowanie e-mailem i hasłem, a przycisk Google się nie pokazuje.
# Redirect URI do wpisania w Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Import: opcjonalny lokalny klon repozytorium midvash/bible-data
# BIBLE_DATA_DIR=/data/bible-data

# --- Dobrowolne wsparcie (BLIK / przelew) ---
# Przycisk „Wesprzyj" pokazuje się, gdy ustawisz numer telefonu (BLIK na telefon) i/lub numer konta.
# Każdy z numerów użytkownik kopiuje jednym kliknięciem.
# SUPPORT_BLIK_PHONE="123456789"
# SUPPORT_ACCOUNT_NUMBER="12 3456 7890 1234 5678 9012 3456"
# Tytuł przelewu (opcjonalnie; domyślnie „Darowizna na rozwój Parallel Bible")
# SUPPORT_TRANSFER_TITLE="Darowizna na rozwój Parallel Bible"
# Nazwa odbiorcy widoczna przy numerze konta (opcjonalnie)
# SUPPORT_RECIPIENT="Imię Nazwisko"

# --- Administratorzy ---
# Adresy (po przecinku), które dostają rolę admina i dostęp do panelu /#/admin.
# Konto musi istnieć — zarejestruj się normalnie tym adresem. Gdy działa SMTP,
# adres musi być potwierdzony. Kolejnych adminów nadaje się już w panelu.
# ADMIN_EMAILS="ty@twoja-domena.pl"

# --- E-mail (SMTP) — potwierdzanie adresu przy rejestracji i reset hasła ---
# Bez SMTP_HOST i MAIL_FROM konto jest aktywne od razu, a "Nie pamiętasz hasła?" się nie pokazuje.
# SMTP_SECURE=true → TLS od razu (port 465), false → STARTTLS (port 587).
# Gmail: smtp.gmail.com, 465, true, hasło aplikacji (nie zwykłe hasło konta).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Nadawca, np. "Parallel Bible <no-reply@twoja-domena.pl>"
MAIL_FROM=

ADMIN_EMAILS=
SUPPORT_ACCOUNT_NUMBER=
SUPPORT_BLIK_PHONE=