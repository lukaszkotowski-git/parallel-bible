# Połączenie do PostgreSQL (w compose host to `db`)
DATABASE_URL="postgresql://bible:zmien_mnie@db:5432/parallel_bible?schema=public"
# Port serwera aplikacji
PORT=5000

# --- Logowanie (Better Auth) ---
# Sekret podpisujący sesje. Wygeneruj: openssl rand -base64 32
# W produkcji jego brak zatrzymuje start aplikacji.
BETTER_AUTH_SECRET=""
# Publiczny adres aplikacji — musi się zgadzać, inaczej odbicie z Google nie wróci.
# Lokalnie można pominąć (domyślnie http://localhost:$PORT).
BETTER_AUTH_URL="https://biblia.twoja-domena.pl"

# Logowanie Google — opcjonalne. Bez tych dwóch zmiennych zostaje samo
# logowanie e-mailem i hasłem, a przycisk Google się nie pokazuje.
# Redirect URI do wpisania w Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Import: opcjonalny lokalny klon repozytorium midvash/bible-data
# BIBLE_DATA_DIR=/data/bible-data
